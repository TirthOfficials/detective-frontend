# Copy to .env.local for local dev. On Vercel, set these in Project → Settings → Environment Variables.

# Anthropic API key (server only, never exposed to the browser)
ANTHROPIC_API_KEY=

# Shared passcode players must enter (protects your API credits). Leave empty to disable locally.
GAME_PASSCODE=

# 1 = scripted replies, zero API cost (use while developing). 0 = real Claude Haiku.
MOCK_LLM=1

# Hard spend cap enforced by the app (USD). Also set a monthly limit in the Anthropic Console!
LLM_BUDGET_USD=3

# Rate limits for LLM-backed questions
RATE_LIMIT_PER_MINUTE=12
RATE_LIMIT_PER_DAY=150
GLOBAL_CALLS_PER_DAY=2000

# Optional but recommended on Vercel: Upstash Redis (free tier) makes the $ cap and rate limits
# global across all serverless instances. Without it, counters are per-instance (in memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
